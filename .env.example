# ══════════════════════════════════════════════════════════════════════════════
# CMB — Chez Maman Biya · Variables d'environnement
# Copiez ce fichier en .env.local et remplissez chaque valeur.
# Ne committez JAMAIS .env.local dans votre dépôt Git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Authentification ──────────────────────────────────────────────────────────
# Clé secrète HMAC-SHA256 pour signer les tokens de session.
# Générez-la avec : openssl rand -hex 32
AUTH_SECRET=

# Clé secrète dédiée à la signature des QR codes de factures.
# DIFFÉRENTE de AUTH_SECRET — permet de révoquer les QR sans invalider les sessions.
# Générez-la avec : openssl rand -hex 32
FACTURE_QR_SECRET=

# Clé API interne utilisée entre services (cron, webhooks internes).
# Générez-la avec : openssl rand -hex 16
INTERNAL_API_KEY=

# ── Base de données (Supabase / Neon / PlanetScale PostgreSQL) ────────────────
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# URL directe (bypasse PgBouncer pour les migrations Prisma)
# Obtenir dans Supabase : Settings → Database → Connection string → URI (mode Session)
# OBLIGATOIRE pour `prisma migrate deploy` et `prisma db push`
DIRECT_URL=

# ── IA — Anthropic Claude ─────────────────────────────────────────────────────
# Obtenez votre clé sur : https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Paiement Mobile Money — CinetPay ─────────────────────────────────────────
# Obtenez vos clés sur : https://dashboard.cinetpay.com → Paramètres API
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Valeurs possibles : TEST (sandbox) ou PROD
CINETPAY_ENV=TEST

# ── URL publique du site ──────────────────────────────────────────────────────
# Utilisée pour les redirections paiement, QR codes, liens WhatsApp.
# En développement : http://localhost:3000
# En production    : https://votre-domaine.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Identité du restaurant ────────────────────────────────────────────────────
RESTAURANT_NOM="Chez Maman Biya"
RESTAURANT_TAGLINE="Restaurant camerounais · Yaoundé"
RESTAURANT_ADRESSE="Quartier Bastos, Yaoundé, Cameroun"
RESTAURANT_TEL="+237677000000"
RESTAURANT_EMAIL="contact@chezmamanbiya.cm"
RESTAURANT_URL="https://chezmamanbiya.cm"
RESTAURANT_LAT="3.8812"
RESTAURANT_LNG="11.5021"



# ── Cloudinary (photos de plats) ──────────────────────────────────────────────
# Obtenez vos identifiants sur : https://cloudinary.com → Dashboard
# Créer un "Unsigned upload preset" dans Settings → Upload
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=cmb_plats

# ── WhatsApp Business API (Meta) ──────────────────────────────────────────────
# Obtenez vos identifiants sur : https://developers.facebook.com
# Graph API → WhatsApp Business → Phone Numbers
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Cache / Rate-limit — Upstash Redis ───────────────────────────────────────
# Obtenez vos clés sur : https://console.upstash.com → Créez une DB Redis
# Utilisé pour le rate-limiting des routes /api/auth/login.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# Ces variables permettent de se connecter avant la création d'un compte via l'interface admin.
# Supprimez-les en production une fois vos comptes créés en base.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=        # Remplacez par un mot de passe fort
ADMIN_NAME=Propriétaire

MANAGER_LOGIN=manager
MANAGER_PASSWORD=      # Remplacez par un mot de passe fort
MANAGER_NAME=Le Gérant

CAISSIER_LOGIN=caissier
CAISSIER_PASSWORD=     # Remplacez par un mot de passe fort
CAISSIER_NAME=Le Caissier

STAFF_LOGIN=staff
STAFF_PASSWORD=        # Remplacez par un mot de passe fort
STAFF_NAME=Staff Cuisine


# FIX I2 — Désactiver le fallback .env une fois tous les comptes migrés en BD
# DISABLE_ENV_FALLBACK=true
