# ============================================================
# CHEZ MAMAN BIYA — Variables d'environnement PRODUCTION
# Copiez ce fichier en .env.production et remplissez toutes
# les valeurs AVANT le premier déploiement.
# ============================================================
# Commande : cp .env.production.example .env.production
# ⚠️  Ne jamais commiter .env.production dans git !
# ============================================================

# ── URL publique du site ──────────────────────────────────
# Sans slash final. Doit correspondre exactement au domaine
# enregistré dans le tableau de bord CinetPay (notify_url).
NEXT_PUBLIC_SITE_URL=https://chezmamanbiya.cm

# ── Base de données Supabase (PostgreSQL) ─────────────────
# Récupérer sur : https://app.supabase.com → Settings → Database
# Utiliser l'URL "Transaction pooler" (port 6543) pour Vercel.
DATABASE_URL=postgresql://postgres.XXXX:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.XXXX:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ── JWT / Sessions ────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET=GENERER_UNE_CHAINE_DE_128_CARACTERES_ALEATOIRES_ICI

# ── Signature QR code factures ────────────────────────────
# Clé DISTINCTE de AUTH_SECRET — permet de révoquer les QR
# sans invalider les sessions utilisateurs.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACTURE_QR_SECRET=GENERER_UNE_CHAINE_DE_64_CARACTERES_ALEATOIRES_ICI

# ── Clé interne (appels API → API sécurisés) ─────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=GENERER_UNE_CHAINE_DE_64_CARACTERES_ALEATOIRES_ICI

# ── CinetPay ─────────────────────────────────────────────
# Récupérer sur : https://cinetpay.com → Mon compte → API
# CINETPAY_ENV : mettre PROD uniquement quand les tests TEST sont validés
CINETPAY_API_KEY=VOTRE_API_KEY_CINETPAY
CINETPAY_SITE_ID=VOTRE_SITE_ID_CINETPAY
CINETPAY_ENV=PROD

# ── WhatsApp Business API (Meta) ──────────────────────────
# Récupérer sur : https://developers.facebook.com → Votre app → WhatsApp
# WHATSAPP_PHONE_ID : Phone number ID (ex: 123456789012345)
# WHATSAPP_TOKEN    : Token permanent (générer dans Meta Business Suite)
# WHATSAPP_RESTO_NUMBER : Numéro du restaurant au format international
#                         (ex: 237677000000 — sans + ni espaces)
WHATSAPP_TOKEN=EAAB...VOTRE_TOKEN_META_WHATSAPP
WHATSAPP_PHONE_ID=VOTRE_PHONE_NUMBER_ID
WHATSAPP_RESTO_NUMBER=237677XXXXXX

# ── Upstash Redis (rate limiting) ────────────────────────
# Récupérer sur : https://console.upstash.com → Votre database → REST API
# Si absent, le rate limiting est désactivé (déconseillé en prod).
UPSTASH_REDIS_REST_URL=https://XXXX.upstash.io
UPSTASH_REDIS_REST_TOKEN=VOTRE_TOKEN_UPSTASH

# ── Cloudinary (photos de plats) ─────────────────────────
# Récupérer sur : https://cloudinary.com → Dashboard
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET : créer un "Unsigned upload preset" dans Settings → Upload
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=VOTRE_CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=cmb_plats

# ── Anthropic (chatbot) ───────────────────────────────────
# Récupérer sur : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_API_ANTHROPIC

# ── NODE_ENV ─────────────────────────────────────────────
NODE_ENV=production

# ============================================================
# CHECKLIST AVANT PREMIER TEST AVEC ARGENT RÉEL
# ============================================================
# [ ] DATABASE_URL et DIRECT_URL testées avec : npx prisma db push
# [ ] AUTH_SECRET et INTERNAL_API_KEY générés (≥64 chars chacun)
# [ ] FACTURE_QR_SECRET généré (≥64 chars) — distinct de AUTH_SECRET
# [ ] CinetPay : webhook enregistré dans le tableau de bord
#       URL à enregistrer : https://chezmamanbiya.cm/api/paiement/webhook
#       Méthode : POST
#       Vérifier avec : curl https://chezmamanbiya.cm/api/paiement/webhook
#       (doit retourner {"ok":true,"service":"...CinetPay Webhook"})
# [ ] CINETPAY_ENV passé de TEST à PROD
# [ ] WhatsApp : token permanent créé (les tokens temporaires expirent en 24h)
# [ ] WHATSAPP_RESTO_NUMBER sans + ni espaces (237677XXXXXX)
# [ ] Upstash Redis actif (rate limiting anti-abus)
# [ ] Cloudinary upload preset configuré en "Unsigned"
# [ ] NEXT_PUBLIC_SITE_URL sans slash final, domaine SSL actif
# ============================================================

# FIX I2 — Décommenter après migration complète des comptes en base
# DISABLE_ENV_FALLBACK=true
